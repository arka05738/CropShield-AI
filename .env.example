# CropShield AI — Environment Configuration (placeholders only)
# Copy to `.env` at the repository root for local development.
# NEVER commit a real `.env` file.

# Runtime: development | production
ENVIRONMENT=development

# Groq LLM (optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face (optional token for gated/rate-limited Hub access)
HF_TOKEN=your_huggingface_token_here

# Disease model — verified multi-model Hugging Face registry
USE_HF_DISEASE_MODEL=true
HF_MODEL_PLANTVILLAGE=kimcomehome/plantvillage-vit-leaf-disease
HF_MODEL_SUGARCANE=LishaV01/agriculture-crop-disease-detection
HF_MODEL_RICE=wambugu71/crop_leaf_diseases_vit
HF_MODEL_WHEAT=wambugu71/crop_leaf_diseases_vit
HF_MODEL_COTTON=YaswanthReddy23/ViT_Cotton
HF_MODEL_SUNFLOWER=YaswanthReddy23/ViT_Sunflower
# Legacy alias for PlantVillage
HF_DISEASE_MODEL_ID=kimcomehome/plantvillage-vit-leaf-disease

# MongoDB (optional — falls back to labelled in-memory store if unreachable)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cropshield

# JWT — REQUIRED in production (min 32 chars, not a placeholder)
JWT_SECRET=generate-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Dev-only soft auth (NEVER true in production — startup fails if enabled in production)
ALLOW_DEMO_AUTH=false

# Dev/test-only demo user seed (NEVER true in production — startup fails if enabled in production)
SEED_DEMO_DATA=false

# ChromaDB persist directory (optional; defaults under Backend/data/chroma)
CHROMA_PERSIST_DIR=

OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

USE_MOCK_AI=false
USE_MOCK_WEATHER=false
USE_MOCK_PEST=false
PEST_MODEL_PATH=
DISEASE_MODEL_DIR=

# Production: set to your Vercel origins only, comma-separated. Do not use *.
# Local defaults apply only when ENVIRONMENT=development and this is unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

MAX_UPLOAD_BYTES=10485760

# --- Farmer (Frontend SIH/.env) production ---
# VITE_API_BASE_URL=https://YOUR_BACKEND_HOST/api/v1

# --- Admin (Admin/.env) production ---
# VITE_API_BASE_URL=https://YOUR_BACKEND_HOST/api/v1
